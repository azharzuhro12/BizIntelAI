# BizIntel AI - contoh konfigurasi environment.
# Salin menjadi .env root project:  cp .env.example .env
# JANGAN commit file .env (sudah dilindungi .gitignore).

# ---------------------------------------------------------------
# PostgreSQL (dipakai docker-compose dan backend via app/db.py)
# ---------------------------------------------------------------
POSTGRES_USER=bizintel
POSTGRES_PASSWORD=ganti-password-lokal
POSTGRES_DB=bizintel
POSTGRES_PORT=5432

# Override koneksi DB untuk backend (opsional; prioritas di atas file .env).
# Dipakai terutama saat backend berjalan di container (docker-compose.yml
# sudah menyetel nilai ini secara otomatis), dan saat menunjuk backend ke
# PostgreSQL remote (mis. Supabase session pooler — lihat
# docs/cloud-deployment.md). PGSSLMODE dibaca native oleh libpq/psycopg2.
# PGHOST=db
# PGPORT=5432
# PGUSER=bizintel
# PGPASSWORD=ganti-password-lokal
# PGDATABASE=bizintel
# PGSSLMODE=require

# ---------------------------------------------------------------
# LLM untuk AI Assistant (BACKEND ONLY - tidak pernah sampai ke frontend)
# Provider Anthropic-compatible; implementasi: backend/app/agent/llm.py.
# Setup langganan GLM (BigModel/Z.ai): dapatkan API key, lalu set:
#   ANTHROPIC_AUTH_TOKEN=<api-key-anda>
#   ANTHROPIC_BASE_URL=https://api.z.ai/api/anthropic
#   ANTHROPIC_MODEL=glm-5.3
# Alternatif klasik Anthropic: ANTHROPIC_API_KEY (+ ANTHROPIC_MODEL).
# Tanpa kredensial ini, dashboard tetap jalan penuh dan /api/chat
# mengembalikan 503 llm_not_configured (bukan crash).
# ---------------------------------------------------------------
# ANTHROPIC_AUTH_TOKEN=
# ANTHROPIC_BASE_URL=https://api.z.ai/api/anthropic
# ANTHROPIC_MODEL=glm-5.3

# ---------------------------------------------------------------
# CORS backend (origin frontend dev; default sudah localhost:3000).
# Port lain -> set mis.: http://localhost:3001,http://127.0.0.1:3001
# ---------------------------------------------------------------
# BIZINTEL_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------------------------------------------------------------
# Docker Compose (dibaca dari .env root saat `docker compose up`).
# FRONTEND_PORT  = port host untuk dashboard (default 3000).
# NEXT_PUBLIC_API_URL = base URL API yang dilihat browser host;
#   dipakai sebagai build-arg image frontend (default http://localhost:8020).
# Catatan: untuk `npm run dev` (tanpa Docker), letakkan NEXT_PUBLIC_API_URL
#   di frontend/.env.local, bukan di sini.
# ---------------------------------------------------------------
# FRONTEND_PORT=3000
# NEXT_PUBLIC_API_URL=http://localhost:8020
